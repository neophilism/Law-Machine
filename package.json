{
  "name": "law-machine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:foundation": "node scripts/check.mjs",
    "check": "pnpm check:foundation && pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test:domain && pnpm scan:secrets",
    "dev": "pnpm --filter @law-machine/web dev",
    "build": "pnpm --filter @law-machine/web build",
    "start": "pnpm --filter @law-machine/web start",
    "typecheck": "tsc --noEmit && pnpm --filter @law-machine/web typecheck",
    "lint": "eslint apps packages tests-domain",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test:domain": "node --test tests-domain/*.test.ts",
    "test:browser": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:dependencies": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2"
  }
}

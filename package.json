{
  "name": "law-machine",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Law Machine foundation and approved implementation registry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node scripts/check.mjs && pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm scan:secrets && pnpm smoke:sdk",
    "check:foundation": "node scripts/check.mjs",
    "dev": "pnpm --filter @law-machine/web dev",
    "build": "pnpm --filter @law-machine/web build",
    "start": "pnpm --filter @law-machine/web start",
    "lint": "eslint apps packages tests/unit",
    "typecheck": "tsc --noEmit",
    "boundaries": "node --import tsx scripts/check-boundaries.ts",
    "scan:secrets": "node --import tsx scripts/scan-secrets.ts",
    "test": "pnpm check",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "audit": "pnpm audit --audit-level=high",
    "validate:registry": "node scripts/validate-pr-registry.mjs",
    "validate:security": "python3 scripts/validate_e2eesa_status.py",
    "smoke:sdk": "node --import tsx scripts/sdk-smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
